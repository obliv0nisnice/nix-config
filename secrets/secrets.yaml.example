sonarqube:
  env: |
    POSTGRES_PASSWORD=ChangeMeStrongPassword
    SONAR_JDBC_PASSWORD=ChangeMeStrongPassword

dependency-track:
  env: |
    POSTGRES_PASSWORD=ChangeMeStrongPassword
    ALPINE_DATABASE_PASSWORD=ChangeMeStrongPassword

homesuite:
  env: |
    ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=homesuite;Username=homesuite;Password=ChangeMeStrongPassword

gitea:
  db-password: ChangeMeStrongPassword
  runner-token: TOKEN=paste-registration-token-from-gitea-webui
  provisioner-token: paste-gitea-personal-access-token-with-repo-scope

step-ca:
  intermediate-password: ChangeMeStrongIntermediatePassword
