+            // TZ0 akzeptiert (ACK2): vor IMG4 nochmal GET_STATUS pingen (wie m1n1).
             MSG_BOOT_TZ0_ACK2 => {
-                let res = self.load_fw_and_shmem();
-                if let Err(e) = res {
-                    dev_err!(self.dev, "Unable to load firmware: {:?}", e);
