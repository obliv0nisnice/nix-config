     fn start(&self) -> Result<()> {
+        // FIX (MacFingerprint): NICHT blind TZ0 feuern, sondern erst GET_STATUS pingen
+        // und auf STATUS_OK warten (dann sendet process_boot_msg TZ0). Exakt die Sequenz
+        // aus m1n1 hw/sep.py::boot(), live auf M1 als funktionierend bestaetigt.
+        self.send_get_status()
+    }
+    fn send_get_status(&self) -> Result<()> {
+        dev_info!(self.dev, "SEP TX: GET_STATUS (ep={:#x} type={:#x})", EP_BOOT, MSG_GET_STATUS);
+        self.mbox.lock().as_ref().unwrap().send(
+            Message {
+                msg0: EP_BOOT | (MSG_GET_STATUS << MSG_TYPE_SHIFT),
+                msg1: 0,
+            },
+            false,
+        )
+    }
+    fn send_tz0(&self) -> Result<()> {
         dev_info!(self.dev, "SEP TX: boot TZ0 (ep={:#x} type={:#x})", EP_BOOT, MSG_BOOT_TZ0);
         self.mbox.lock().as_ref().unwrap().send(
             Message {
@@ -224,11 +248,29 @@
     fn process_boot_msg(&self, msg: Message) {
         let ty = (msg.msg0 >> MSG_TYPE_SHIFT) & MSG_TYPE_MASK;
         match ty {
+            // GET_STATUS-Antwort: der SEPROM ist ansprechbar. Stufenweise weiter (m1n1-Sequenz):
+            // 1. OK -> TZ0 senden; 2. OK (nach TZ0-ACK2) -> Firmware/Shmem laden.
+            MSG_STATUS_OK => match self.boot_stage.load(Ordering::Relaxed) {
+                0 => {
+                    self.boot_stage.store(1, Ordering::Relaxed);
+                    if let Err(e) = self.send_tz0() {
+                        dev_err!(self.dev, "Unable to send TZ0: {:?}", e);
+                    }
+                }
+                2 => {
+                    self.boot_stage.store(3, Ordering::Relaxed);
+                    if let Err(e) = self.load_fw_and_shmem() {
+                        dev_err!(self.dev, "Unable to load firmware: {:?}", e);
+                    }
+                }
+                s => dev_warn!(self.dev, "STATUS_OK in unexpected boot stage {}", s),
+            },
