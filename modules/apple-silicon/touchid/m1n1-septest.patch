m1n1: SEP wake-timing diagnostic (MacFingerprint Touch ID RE). Probe the SEP ROM
(sep_get_random) at TWO points in m1n1_main: [early] right after sep_init(), and
[late] after run_actions() (just before u-boot handoff). Forces fb console on +
pauses so results are visible. Tells us whether the SEP is awake early in m1n1 and
sleeps during it, or already asleep before m1n1 starts. Applies to m1n1 1.5.2.

--- a/src/main.c
+++ b/src/main.c
@@ -177,12 +177,35 @@
 
     cpufreq_fixup();
     sep_init();
+    {
+        u32 r = 0;
+        size_t n = sep_get_random(&r, sizeof(r));
+#ifdef USE_FB
+        fb_set_active(true);
+#endif
+        printf("\n======== SEPTEST[early] ========\n");
+        printf("SEPTEST[early]: %d bytes rand=0x%08x %s\n", (int)n, r,
+               n == sizeof(r) ? "(SEP AWAKE)" : "(NO RESPONSE)");
+        mdelay(5000);
+    }
 #endif
 
     printf("Initialization complete.\n");
 
     run_actions();
 
+    {
+        u32 r = 0;
+        size_t n = sep_get_random(&r, sizeof(r));
+#ifdef USE_FB
+        fb_set_active(true);
+#endif
+        printf("\n======== SEPTEST[late] ========\n");
+        printf("SEPTEST[late]: %d bytes rand=0x%08x %s\n", (int)n, r,
+               n == sizeof(r) ? "(SEP AWAKE)" : "(NO RESPONSE)");
+        mdelay(12000);
+    }
+
     if (!next_stage.entry) {
         panic("Nothing to do!\n");
     }
